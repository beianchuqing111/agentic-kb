# 复制成 .env 后填真值。.env 已被 .gitignore 排除。
# ⚠️ 不要把真密钥贴进任何对话/issue/截图。

# ---------- LLM(建图抽取 / 上下文增强 / ReAct 都要用) ----------
# 中文语料请选中文强的模型。OpenAI 兼容接口即可。
#   DeepSeek https://api.deepseek.com/v1                        model=deepseek-chat
#   Kimi     https://api.moonshot.cn/v1                         model=kimi-k3
#   Qwen     https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 向量库 ----------
# 独立端口 + 独立 storage,避免与 imgsearch 那个 qdrant 抢 6333 或互相污染数据
QDRANT_URL=http://127.0.0.1:6343
QDRANT_API_KEY=
QDRANT_COLLECTION=agentic_kb
QDRANT_EXE=D:\imgsearch\qdrant_server\qdrant.exe
QDRANT_STORAGE=D:\agentic-kb\qdrant_storage

# ---------- 图数据库(本地 Neo4j Community) ----------
# 已经装好了(5.26.9,自带 JRE),启动用 scripts\start_neo4j.bat。
# 密码就是下面这个,是装的时候用 neo4j-admin dbms set-initial-password 设的
# ——该命令只在**数据库首次启动前**有效,所以别指望以后还能改。
# 重建步骤(两个压缩包已缓存在 neo4j\downloads\)写在 start_neo4j.bat 顶部注释里。
# 注意 bolt:// 是明文本地连接;连云端要用 neo4j+s:// 加密后缀。
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=agentic-kb-local
NEO4J_DATABASE=neo4j

# ---------- 网页搜索 ----------
TAVILY_API_KEY=

# ---------- 运行后端 ----------
# hybrid | graphrag
KB_BACKEND=hybrid

# ---------- ReAct 智能体(都有合理默认,一般不用改)----------
# 检索轮数上限。调大能查得更深,但每轮都是一次 LLM 调用 + 一次检索
# AGENT_MAX_ITER=8
# 单条工具结果进历史前的字符上限。**别调成 0** —— 不截断的话,
# 一次误读大文件就能把历史涨到几十 MB,下一轮直接 400(超模型上下文),
# 而且日志里看不出原因
# AGENT_TOOL_MAX_CHARS=8000
# 输出不合 ReAct 格式时最多纠正几次,超过就直接用它最后那段文本当答案
# AGENT_FORMAT_RETRIES=2
# ReAct 要的是格式稳定不是文采,默认 0,别调高
# AGENT_TEMPERATURE=0.0

# 写工具(导出报告 / 标记法条失效)总开关。默认关。
# **打开它只是过了第一道闸** —— 每次写操作还要在终端单独确认一次
# (kb.py ask --allow-write),没人点头照样拒绝。CLI 的 --allow-write
# 和这个变量任一打开即可;批处理/无头环境里读不到确认,一律按拒绝处理。
# AGENT_ALLOW_WRITE=0
# 审计日志路径。每次写调用记 intent / result(或 denied)三条,append-only。
# AGENT_AUDIT_LOG=logs/audit.jsonl

# ---------- 检索调参 ----------
# 低于这个重排分的不返回
# RERANK_MIN_SCORE=0.05
# 但至少保留几条。默认 1:全都不相关时也给调用方一个「确实没好结果」的
# 信号,而不是空列表(空列表会被误读成检索故障)。副作用是只要库里有块,
# 任何查询都会返回至少一条 —— 想让不相关的结果真的返回空,这里设 0
# RERANK_MIN_KEEP=1

# 召回时是否带上被标记失效的历史版本。默认关 = 只召回有效版本。
# 打开它是为了「查废止条款原来怎么写的」这类需求 —— 旧版本从来没被删除,
# 只是默认不参与召回。注意这是**整个进程**的口径,不是单次查询的偏好:
# 按次切换会让同一条问题在不同入口得到不同答案。
# INCLUDE_SUPERSEDED=0

# ---------- 可选 ----------
# HF_ENDPOINT=https://hf-mirror.com
# KB_DEVICE=cuda
# 建图抽取时的实体/关系类型白名单(留空 = 让 LLM 自由发挥)
# GRAPH_ENTITY_TYPES=设备,部件,缺陷,位置,人员,标准
# GRAPH_RELATION_TYPES=包含,导致,属于,检测方法
